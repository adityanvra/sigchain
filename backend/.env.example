# ============================================================
# SIGCHAIN-UAD Backend Environment Configuration
# Copy to .env and fill the values. NEVER commit real secrets.
# ============================================================

# Server
NODE_ENV=development
PORT=5000
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (MongoDB Atlas). Leave empty to run in MOCK_MODE (in-memory).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sigchain?retryWrites=true&w=majority

# Blockchain (Ethereum Sepolia via Alchemy). Leave RPC/CONTRACT empty to use
# a mock in-memory chain so the full app still works without external setup.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=11155111
CONTRACT_ADDRESS=0xYourDeployedContractAddress
BLOCK_EXPLORER=https://sepolia.etherscan.io

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Public base URL used inside generated QR codes (frontend verify page)
PUBLIC_VERIFY_URL=http://localhost:5173/verify
