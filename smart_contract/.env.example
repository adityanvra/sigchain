# Smart contract deployment configuration (Ethereum Sepolia testnet)
# Copy to .env and fill the values. NEVER commit your real .env.

# Alchemy / Infura HTTPS RPC endpoint for Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of a TEST wallet only (never your main wallet)
PRIVATE_KEY=0xyour_test_wallet_private_key

# Optional: for `npm run verify:sepolia`
ETHERSCAN_API_KEY=your_etherscan_api_key
